# Copia este archivo como .streamlit/secrets.toml y pon tu token real.
# NUNCA subas secrets.toml a GitHub (ya está en .gitignore).
# Token en: console.apify.com → Settings → API & Integrations → Personal API tokens
APIFY_TOKEN = "apify_api_XXXXXXXXXXXXXXXXXXXXXXXX"

# Punto de partida: ubicación física de tu trabajo.
# Puede ser una dirección o las coordenadas copiadas de Google Maps ("19.3911, -99.1071").
BASE_NOMBRE = "Mi trabajo"
BASE_DIRECCION = "Calle y número, Colonia, C.P., Alcaldía, CDMX"
