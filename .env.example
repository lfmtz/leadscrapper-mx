# Variables para Netlify (Site configuration > Environment variables).
# Para probar en tu computadora, copia este archivo a .env y usa "netlify dev".
# NUNCA subas el archivo .env con valores reales a GitHub.

# Token de Apify: https://console.apify.com/settings/integrations
APIFY_TOKEN="apify_api_xxxxxxxxxxxxxxxx"

# Token del DENUE de INEGI: https://www.inegi.org.mx/servicios/api_denue.html
INEGI_TOKEN="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Código que la app te pide antes de gastar créditos (inventa uno largo).
APP_ACCESS_CODE="cambia-este-codigo"

# Máximo de registros por término en una corrida (opcional).
MAX_PLACES_PER_RUN="1000"
